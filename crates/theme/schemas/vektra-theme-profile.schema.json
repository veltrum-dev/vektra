{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veltrum.dev/schemas/vektra-theme-profile.phase1.json",
  "title": "Vektra Theme Profile Phase 1",
  "description": "Documents Vektra's required base tokens and optional all-or-none component extensions after DTCG token resolution.",
  "type": "object",
  "required": ["semantic", "icon", "button"],
  "properties": {
    "semantic": {
      "type": "object",
      "required": [
        "background",
        "surface",
        "foreground",
        "primary",
        "on-primary",
        "secondary",
        "on-secondary",
        "accent",
        "on-accent",
        "destructive",
        "on-destructive",
        "muted",
        "on-muted",
        "border",
        "input-border",
        "ring",
        "disabled-background",
        "disabled-foreground",
        "disabled-border"
      ]
    },
    "icon": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "size": {
          "type": "object",
          "required": ["default"]
        }
      }
    },
    "tooltip": {
      "type": "object",
      "description": "The original content token set remains all-or-none. Placement, arrow, viewport, and shadow tokens are optional extensions with runtime foundation/semantic fallbacks.",
      "required": ["background", "foreground", "border", "border-width", "padding-x", "padding-y", "radius", "font-size", "line-height", "max-width"]
    },
    "button": {
      "type": "object",
      "required": ["variant", "size"],
      "properties": {
        "variant": {
          "type": "object",
          "description": "Each Button variant requires the base state matrix and may add a complete selected state matrix (normal, hover, pressed, focus-visible, disabled). Themes without selected tokens remain compatible through runtime fallback."
        },
        "size": {
          "type": "object"
        }
      }
    },
    "input": {
      "type": "object",
      "description": "Optional Input extension. When present it must contain the complete common, variant/state, and size matrices; themes that omit it use semantic/foundation fallbacks.",
      "required": ["border-width", "focus-width", "caret-width", "variant", "size"],
      "properties": {
        "variant": {
          "type": "object",
          "required": ["outline", "filled", "borderless", "underline"],
          "properties": {
            "outline": { "$ref": "#/$defs/inputVariant" },
            "filled": { "$ref": "#/$defs/inputVariant" },
            "borderless": { "$ref": "#/$defs/inputVariant" },
            "underline": { "$ref": "#/$defs/inputVariant" }
          }
        },
        "size": {
          "type": "object",
          "required": ["xs", "sm", "md", "lg"],
          "properties": {
            "xs": { "$ref": "#/$defs/inputSize" },
            "sm": { "$ref": "#/$defs/inputSize" },
            "md": { "$ref": "#/$defs/inputSize" },
            "lg": { "$ref": "#/$defs/inputSize" }
          }
        }
      }
    }
  },
  "$defs": {
    "inputVariant": {
      "type": "object",
      "required": ["normal", "hover", "focus-visible", "invalid", "invalid-focus-visible", "read-only", "disabled"],
      "properties": {
        "normal": { "$ref": "#/$defs/inputState" },
        "hover": { "$ref": "#/$defs/inputState" },
        "focus-visible": { "$ref": "#/$defs/inputState" },
        "invalid": { "$ref": "#/$defs/inputState" },
        "invalid-focus-visible": { "$ref": "#/$defs/inputState" },
        "read-only": { "$ref": "#/$defs/inputState" },
        "disabled": { "$ref": "#/$defs/inputState" }
      }
    },
    "inputState": {
      "type": "object",
      "required": ["background", "foreground", "placeholder", "border", "caret", "selection", "affix", "status"]
    },
    "inputSize": {
      "type": "object",
      "required": ["height", "padding-x", "font-size", "line-height", "radius", "slot-size", "icon-size", "status-size", "gap"]
    }
  }
}
