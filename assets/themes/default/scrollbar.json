{
  "scrollbar": {
    "track": { "$type": "color", "$value": "{semantic.secondary}" },
    "thumb": { "$type": "color", "$value": "{semantic.on-muted}" },
    "thumb-hover": { "$type": "color", "$value": "{semantic.foreground}" },
    "thumb-pressed": { "$type": "color", "$value": "{semantic.foreground}" },
    "focus-ring": { "$type": "color", "$value": "{semantic.ring}" },
    "thickness": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "thumb-hover-thickness": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
    "hit-thickness": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
    "min-thumb-length": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "radius": { "$type": "dimension", "$value": "{foundation.radius.md}" },
    "focus-width": { "$type": "dimension", "$value": "{foundation.border.focus}" }
  }
}
