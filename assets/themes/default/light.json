{
  "semantic": {
    "$type": "color",
    "background": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1 } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [0.984, 0.984, 0.985], "alpha": 1 } },
    "foreground": { "$value": { "colorSpace": "srgb", "components": [0.035, 0.039, 0.043], "alpha": 1 } },
    "primary": { "$value": { "colorSpace": "srgb", "components": [0.27, 0.27, 0.29], "alpha": 1 } },
    "primary-hover": { "$value": { "colorSpace": "srgb", "components": [0.23, 0.23, 0.25], "alpha": 1 } },
    "primary-pressed": { "$value": { "colorSpace": "srgb", "components": [0.19, 0.19, 0.21], "alpha": 1 } },
    "on-primary": { "$value": { "colorSpace": "srgb", "components": [0.98, 0.98, 0.98], "alpha": 1 } },
    "secondary": { "$value": { "colorSpace": "srgb", "components": [0.961, 0.961, 0.964], "alpha": 1 } },
    "secondary-hover": { "$value": { "colorSpace": "srgb", "components": [0.925, 0.925, 0.93], "alpha": 1 } },
    "secondary-pressed": { "$value": { "colorSpace": "srgb", "components": [0.89, 0.89, 0.9], "alpha": 1 } },
    "on-secondary": { "$value": "{semantic.foreground}" },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.944, 0.945, 0.948], "alpha": 1 } },
    "accent-hover": { "$value": { "colorSpace": "srgb", "components": [0.9, 0.902, 0.908], "alpha": 1 } },
    "accent-pressed": { "$value": { "colorSpace": "srgb", "components": [0.5, 0.5, 0.52], "alpha": 1 } },
    "on-accent": { "$value": "{semantic.foreground}" },
    "destructive": { "$value": { "colorSpace": "srgb", "components": [0.86, 0.12, 0.12], "alpha": 1 } },
    "destructive-hover": { "$value": { "colorSpace": "srgb", "components": [0.74, 0.09, 0.09], "alpha": 1 } },
    "destructive-pressed": { "$value": { "colorSpace": "srgb", "components": [0.62, 0.07, 0.07], "alpha": 1 } },
    "on-destructive": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1 } },
    "muted": { "$value": { "colorSpace": "srgb", "components": [0.965, 0.965, 0.97], "alpha": 1 } },
    "on-muted": { "$value": { "colorSpace": "srgb", "components": [0.39, 0.4, 0.43], "alpha": 1 } },
    "border": { "$value": { "colorSpace": "srgb", "components": [0.54, 0.54, 0.56], "alpha": 1 } },
    "input-border": { "$value": { "colorSpace": "srgb", "components": [0.58, 0.58, 0.6], "alpha": 1 } },
    "ring": { "$value": "{semantic.foreground}" },
    "link": { "$value": { "colorSpace": "srgb", "components": [0.1, 0.25, 0.78], "alpha": 1 } },
    "disabled-background": { "$value": { "colorSpace": "srgb", "components": [0.94, 0.94, 0.945], "alpha": 1 } },
    "disabled-foreground": { "$value": { "colorSpace": "srgb", "components": [0.55, 0.56, 0.58], "alpha": 1 } },
    "disabled-border": { "$value": { "colorSpace": "srgb", "components": [0.88, 0.88, 0.89], "alpha": 1 } }
  }
}
