{
  "foundation": {
    "space": {
      "$type": "dimension",
      "0": { "$value": { "value": 0, "unit": "px" } },
      "1": { "$value": { "value": 4, "unit": "px" } },
      "1_5": { "$value": { "value": 6, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "2_5": { "$value": { "value": 10, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": { "value": 4, "unit": "px" } },
      "md": { "$value": { "value": 6, "unit": "px" } }
    },
    "font": {
      "size": {
        "$type": "dimension",
        "xs": { "$value": { "value": 12, "unit": "px" } },
        "sm": { "$value": { "value": 13, "unit": "px" } },
        "md": { "$value": { "value": 14, "unit": "px" } }
      }
    },
    "border": {
      "$type": "dimension",
      "width": { "$value": { "value": 1, "unit": "px" } },
      "focus": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "default": { "$value": { "value": 16, "unit": "px" } }
    }
  }
}
