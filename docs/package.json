{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run preview:build && vitepress dev --host 127.0.0.1",
    "dev:vitepress": "vitepress dev --host 127.0.0.1",
    "build": "bun run preview:build && vitepress build && bun run api:publish",
    "serve": "vitepress preview --host 127.0.0.1",
    "preview:build": "bun run scripts/build-preview.ts",
    "api:rustdoc": "cd .. && cargo doc -p vektra --all-features --no-deps",
    "api:publish": "bun run scripts/build-rustdoc.ts"
  },
  "devDependencies": {
    "lucide-vue-next": "1.0.0",
    "vitepress": "1.6.4",
    "vue": "3.5.41"
  }
}
